# --- Configurações Globais ---
# Senha usada em todos os serviços (RabbitMQ, Redis, Postgres)
GLOBAL_PASSWORD=
NETWORK_NAME=

# --- Infraestrutura ---
EUREKA_PORT=
GATEWAY_PORT=

RABBITMQ_USER=
RABBITMQ_AMQP_PORT=
RABBITMQ_MGMT_PORT=

REDIS_PORT=

# --- Banco de Dados (Nomes e Portas Externas) ---

DB_OFF_NAME=ms-off
DB_OFF_EXT_PORT=

DB_CADASTRO_NAME=
DB_CADASTRO_EXT_PORT=

DB_ANAMNESE_NAME=
DB_ANAMNESE_EXT_PORT=

DB_HISTORICO_NAME=
DB_HISTORICO_EXT_PORT=

DB_FAVORITOS_NAME=
DB_FAVORITOS_EXT_PORT=

# --- Microservices (Portas da Aplicação) ---
MS_CADASTRO_PORT=
MS_OFF_PORT=
MS_ANAMNESE_PORT=
MS_HISTORICO_PORT=
MS_EMAIL_PORT=
MS_FAVORITOS_PORT=


# --- Armazenamento de fotos de perfil (Amazon S3) ---
AWS_REGION=us-east-1
# Nome do bucket (saída "profile_pictures_bucket" do Terraform)
AWS_S3_BUCKET=
# Só para desenvolvimento local; em produção deixe vazio (a EC2 usa IAM Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d
